.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
  text-align: center;
}

.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background: #fff3e6;
  font-size: 64rpx;
  line-height: 1;
}

.title {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
}

.desc {
  margin-top: 12rpx;
  color: #9aa0a8;
  font-size: 26rpx;
  line-height: 1.6;
}

.action {
  margin-top: 36rpx;
}
