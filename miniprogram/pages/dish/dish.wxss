.cover {
  width: 750rpx;
  height: 500rpx;
}

.content {
  position: relative;
  margin-top: -48rpx;
}

.info {
  padding-top: 32rpx;
}

.name {
  margin-bottom: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.desc {
  margin-top: 20rpx;
  color: var(--text-2);
  font-size: 28rpx;
  line-height: 1.7;
}

.stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--border);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat + .stat {
  border-left: 2rpx solid var(--border);
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.ingredient {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  color: #8a5a00;
  background: #fff6e0;
  font-size: 26rpx;
}

.step {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 0;
}

.step-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  color: #ffffff;
  background: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-align: center;
}

.step-text {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
}

.bottom-bar .bar-small {
  flex: 0 0 180rpx;
}
