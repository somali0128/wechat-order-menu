page {
  height: 100%;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 头部 */
.header {
  flex-shrink: 0;
  padding: 20rpx 24rpx 24rpx;
  background: #ffffff;
}

.header-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.slogan {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.family {
  flex-shrink: 0;
  max-width: 220rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  font-size: 24rpx;
  line-height: 52rpx;
}

.visit-btn {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: var(--blue);
  background: var(--blue-light);
  font-size: 24rpx;
  line-height: 52rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f6f7;
}

.search-icon {
  position: relative;
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  margin-right: 16rpx;
  border: 4rpx solid #a8adb4;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 4rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #a8adb4;
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #c4c8ce;
  font-size: 30rpx;
  line-height: 38rpx;
  text-align: center;
}

/* 主体 */
.body {
  display: flex;
  flex: 1;
  min-height: 0;
  border-top: 2rpx solid var(--border);
}

.sidebar {
  flex-shrink: 0;
  width: 172rpx;
  height: 100%;
  background: #f7f8fa;
}

.side-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 20rpx 16rpx;
  color: var(--text-2);
  font-size: 26rpx;
  text-align: center;
}

.side-item.active {
  color: var(--text);
  background: #ffffff;
  font-weight: 600;
}

.side-item.active::before {
  content: "";
  position: absolute;
  top: 34rpx;
  bottom: 34rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--primary);
}

.side-text {
  word-break: break-all;
  line-height: 1.35;
}

.side-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  color: #ffffff;
  background: var(--red);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
}

.list {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: #ffffff;
}

.list-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.list-count {
  margin-left: 12rpx;
  color: var(--text-3);
  font-size: 24rpx;
  font-weight: 400;
}

.dish {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.dish-hover {
  background: #fafafa;
}

.dish-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  min-height: 152rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.dish-desc {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 10rpx;
}

.dish-meta {
  flex: 1;
  min-width: 0;
  color: var(--text-3);
  font-size: 22rpx;
}

.pick {
  flex-shrink: 0;
  width: 128rpx;
  height: 56rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  text-align: center;
}

.pick.on {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.list-end {
  padding: 24rpx 0 40rpx;
  color: #c4c8ce;
  font-size: 22rpx;
  text-align: center;
}

/* 底部已选栏 */
.cart-bar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 2rpx solid var(--border);
}

.cart-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-light);
  font-size: 40rpx;
  line-height: 1;
}

.cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 17rpx;
  color: #ffffff;
  background: var(--red);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}

.cart-title {
  font-size: 28rpx;
  font-weight: 600;
}

.cart-desc {
  color: var(--text-3);
  font-size: 22rpx;
}

.cart-btn {
  flex-shrink: 0;
  width: 184rpx;
  height: 76rpx;
  border-radius: 38rpx;
  color: #ffffff;
  background: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.cart-btn.disabled {
  background: #d5d8dc;
}
