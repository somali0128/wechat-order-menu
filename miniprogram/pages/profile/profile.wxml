<view class="container">
  <!-- 个人信息 -->
  <view class="card user" hover-class="cell-hover" bindtap="editProfile">
    <image wx:if="{{user.avatarUrl}}" class="avatar user-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-text user-avatar">{{user.initial}}</view>
    <view class="flex1">
      <view class="user-name ellipsis">{{user.nickName || '未设置昵称'}}</view>
      <view class="user-sub">
        <text class="tag {{family.isOwner ? 'orange' : 'gray'}}">{{family.isOwner ? '管理员' : '成员'}}</text>
        <text class="user-family ellipsis">{{family.name}}</text>
      </view>
    </view>
    <view class="cell-arrow"></view>
  </view>

  <!-- 统计 -->
  <view class="card stats">
    <view class="stat" bindtap="goManage">
      <view class="stat-value">{{stats.dishes}}</view>
      <view class="stat-label">菜品</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{stats.active}}</view>
      <view class="stat-label">进行中</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{stats.orders}}</view>
      <view class="stat-label">累计订单</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{stats.members}}</view>
      <view class="stat-label">成员</view>
    </view>
  </view>

  <!-- 家庭 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title ellipsis">{{family.name}}</view>
      <view wx:if="{{family.isOwner}}" class="card-link" bindtap="renameFamily">修改名称</view>
    </view>

    <view class="invite">
      <view class="flex1">
        <view class="invite-label">家庭邀请码</view>
        <view class="invite-code">{{family.inviteCode}}</view>
      </view>
      <view class="invite-actions">
        <view class="btn small plain" hover-class="btn-hover" bindtap="copyCode">复制</view>
        <button class="btn-reset" open-type="share" data-type="invite">
          <view class="btn small" hover-class="btn-hover">邀请家人</view>
        </button>
      </view>
    </view>
    <view wx:if="{{family.isOwner}}" class="reset" bindtap="resetCode">重置邀请码</view>

    <view class="members-title">家庭成员 · {{members.length}}</view>
    <view
      wx:for="{{members}}"
      wx:key="openid"
      class="member"
      data-index="{{index}}"
      bindtap="onMemberTap"
    >
      <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-text">{{item.initial}}</view>
      <view class="member-name ellipsis">{{item.nickName}}</view>
      <text wx:if="{{item.isMe}}" class="tag blue">我</text>
      <text wx:if="{{item.isOwner}}" class="tag orange">管理员</text>
      <view wx:if="{{family.isOwner && !item.isMe}}" class="member-more">···</view>
    </view>
  </view>

  <!-- 来访 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">来访</view>
      <view class="card-link" bindtap="goVisitors">谁来过{{stats.visitorsToday ? ' · 今日 ' + stats.visitorsToday : ''}} ›</view>
    </view>

    <view class="invite visit">
      <view class="flex1">
        <view class="invite-label">访问码 · 只能看菜单</view>
        <view class="invite-code visit-code">{{family.visitCode}}</view>
      </view>
      <view class="invite-actions">
        <view class="btn small plain" hover-class="btn-hover" bindtap="copyVisitCode">复制</view>
        <button class="btn-reset" open-type="share" data-type="visit">
          <view class="btn small visit-share" hover-class="btn-hover">分享菜单</view>
        </button>
      </view>
    </view>
    <view class="visit-links">
      <view class="visit-link" bindtap="shareTimeline">预览 / 发朋友圈 ›</view>
      <view wx:if="{{family.isOwner}}" class="visit-link muted" bindtap="resetVisitCode">重置访问码</view>
    </view>

    <view class="switch-row">
      <view class="flex1">
        <view class="switch-title">开放浏览</view>
        <view class="switch-desc">开启后，你家菜单会出现在别人「串门」的随机推荐里</view>
      </view>
      <switch wx:if="{{family.isOwner}}" checked="{{family.openBrowse}}" color="#ff8a1f" bindchange="onOpenBrowseChange" />
      <text wx:else class="tag {{family.openBrowse ? 'green' : 'gray'}}">{{family.openBrowse ? '已开启' : '未开启'}}</text>
    </view>
    <view wx:if="{{!family.isOwner}}" class="switch-note">只有管理员可以修改</view>
  </view>

  <!-- 功能入口 -->
  <view class="card flush">
    <view class="cell" hover-class="cell-hover" bindtap="goManage">
      <text class="cell-icon">🍲</text>
      <text class="cell-title">菜品管理</text>
      <text class="cell-value">{{stats.dishes}} 道</text>
      <view class="cell-arrow"></view>
    </view>
    <view class="cell" hover-class="cell-hover" bindtap="goCategories">
      <text class="cell-icon">🗂</text>
      <text class="cell-title">分类管理</text>
      <view class="cell-arrow"></view>
    </view>
    <view class="cell" hover-class="cell-hover" bindtap="goVisit">
      <text class="cell-icon">🚪</text>
      <text class="cell-title">去别人家逛逛</text>
      <view class="cell-arrow"></view>
    </view>
    <view class="cell" hover-class="cell-hover" bindtap="goVisitors">
      <text class="cell-icon">👀</text>
      <text class="cell-title">谁来过</text>
      <text class="cell-value">{{stats.visitorsToday ? '今日 ' + stats.visitorsToday + ' 位' : ''}}</text>
      <view class="cell-arrow"></view>
    </view>
    <view wx:if="{{subscribeEnabled}}" class="cell" hover-class="cell-hover" bindtap="subscribeNotice">
      <text class="cell-icon">🔔</text>
      <text class="cell-title">订单提醒</text>
      <text class="cell-value">点击订阅</text>
      <view class="cell-arrow"></view>
    </view>
    <view class="cell" hover-class="cell-hover" bindtap="editProfile">
      <text class="cell-icon">👤</text>
      <text class="cell-title">编辑个人资料</text>
      <view class="cell-arrow"></view>
    </view>
  </view>

  <view class="card flush">
    <view class="cell leave" hover-class="cell-hover" bindtap="leave">
      <text class="cell-title">{{leaveText}}</text>
    </view>
  </view>
</view>
