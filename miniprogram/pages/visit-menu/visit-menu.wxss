.top {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
}

.banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-sub {
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.chips {
  padding: 16rpx 24rpx 20rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  height: 56rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  color: var(--text-2);
  background: #f2f3f5;
  font-size: 26rpx;
  line-height: 56rpx;
}

.chip.active {
  color: #ffffff;
  background: var(--primary);
  font-weight: 600;
}

.dish {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid var(--border);
}

.dish:last-child {
  border-bottom: none;
}

.dish-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  min-height: 152rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.dish-desc {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.dish-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 10rpx;
}

.like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  color: var(--text-2);
  background: #f5f6f7;
  font-size: 24rpx;
}

.like.on {
  color: var(--red);
  background: var(--red-light);
}

.heart {
  font-size: 30rpx;
  line-height: 1;
}

.collect {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.collect.done {
  color: var(--green);
  background: var(--green-light);
}

.footnote {
  padding: 12rpx 0 40rpx;
  color: var(--text-3);
  font-size: 22rpx;
  text-align: center;
}

.notice {
  margin: 12rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  font-size: 24rpx;
  line-height: 1.5;
}
