.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
}

.go-btn {
  flex-shrink: 0;
  width: 180rpx;
  padding: 0;
}

.tip {
  margin-top: 20rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.recent {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recent-item {
  max-width: 100%;
  height: 60rpx;
  padding: 0 24rpx;
  overflow: hidden;
  border-radius: 30rpx;
  color: var(--text);
  background: #f5f6f7;
  font-size: 26rpx;
  line-height: 60rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.state-text.small {
  padding: 48rpx 0;
}

.family {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 -28rpx;
  padding: 20rpx 28rpx;
  border-top: 2rpx solid var(--border);
}

.previews {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  width: 304rpx;
}

.family-body {
  flex: 1;
  min-width: 0;
}

.family-name {
  font-size: 30rpx;
  font-weight: 600;
}

.family-sub {
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 24rpx;
}
