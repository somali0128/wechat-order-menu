<view class="page manage-page">
  <view class="manage-hero">
    <view>
      <view class="hero-title">共享菜单</view>
      <view class="hero-subtitle">新增、编辑或移除菜品后，家人设备会同步更新。</view>
    </view>
    <view class="hero-count">{{dishes.length}}</view>
  </view>

  <view class="form-panel">
    <view class="panel-head">
      <view>
        <view class="section-title">{{editing ? '编辑菜品' : '添加菜品'}}</view>
        <view class="section-subtitle">菜名、分类和食材是必填项</view>
      </view>
      <button wx:if="{{editing}}" class="text-btn" bindtap="resetForm">取消</button>
    </view>

    <view class="field-grid">
      <input class="field" placeholder="菜名" value="{{form.name}}" data-field="name" bindinput="updateField" />
      <input class="field" placeholder="分类，如 中餐" value="{{form.category}}" data-field="category" bindinput="updateField" />
      <input class="field" placeholder="标签，如 快手" value="{{form.tag}}" data-field="tag" bindinput="updateField" />
      <input class="field" placeholder="热量，如 约160 kcal" value="{{form.calories}}" data-field="calories" bindinput="updateField" />
      <input class="field" placeholder="蛋白质，如 蛋白质 11g" value="{{form.protein}}" data-field="protein" bindinput="updateField" />
      <picker range="{{toneOptions}}" value="{{toneIndex}}" bindchange="changeTone">
        <view class="field picker-field">色块：{{form.imageTone}}</view>
      </picker>
    </view>

    <textarea
      class="textarea"
      placeholder="简介"
      value="{{form.description}}"
      data-field="description"
      bindinput="updateField"
    />
    <textarea
      class="textarea"
      placeholder="食材，用顿号、逗号或换行分隔"
      value="{{form.ingredientText}}"
      data-field="ingredientText"
      bindinput="updateField"
    />

    <button class="primary-btn save-btn" loading="{{saving}}" bindtap="saveDish">
      {{editing ? '保存修改' : '添加菜品'}}
    </button>
  </view>

  <view class="list-panel">
    <view class="section-title">当前菜品</view>
    <view wx:if="{{loading}}" class="empty">正在同步...</view>
    <view wx:elif="{{!dishes.length}}" class="empty">还没有菜品，先添加一道。</view>
    <block wx:else>
      <block wx:for="{{dishes}}" wx:key="id">
        <view class="dish-row">
          <view class="dish-cover tone-{{item.imageTone}}">{{item.initial}}</view>
          <view class="dish-info">
            <view class="dish-name">{{item.name}}</view>
            <view class="dish-meta">{{item.category}} · {{item.tag}}</view>
            <view class="dish-ingredients">{{item.ingredientText}}</view>
          </view>
          <view class="dish-actions">
            <button class="small-btn" data-id="{{item.id}}" bindtap="editDish">编辑</button>
            <button class="small-btn danger" data-id="{{item.id}}" bindtap="confirmRemove">移除</button>
          </view>
        </view>
      </block>
    </block>
  </view>
</view>
