.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 160rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffad2f 0%, #ff8a1f 48%, #1e88e5 100%);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.45;
  opacity: 0.92;
}

.sync-pill {
  flex: 0 0 108rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(38, 50, 56, 0.08);
}

.user-row,
.member-row,
.panel-head,
.auth-actions,
.menu-card {
  display: flex;
  align-items: center;
}

.user-row,
.panel-head {
  justify-content: space-between;
  gap: 20rpx;
}

.auth-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.avatar,
.member-avatar {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #eff7ff;
}

.placeholder,
.text-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1e88e5;
  font-weight: 800;
}

.user-info,
.member-info {
  min-width: 0;
  flex: 1;
}

.user-name,
.member-name {
  overflow: hidden;
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc,
.member-meta,
.section-subtitle {
  margin-top: 8rpx;
  color: #7b8794;
  font-size: 24rpx;
}

.auth-actions {
  gap: 16rpx;
}

.menu-card {
  justify-content: space-between;
  gap: 20rpx;
}

.manage-btn {
  flex: 0 0 188rpx;
}

.auth-btn {
  flex: 1;
}

.section-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.text-btn {
  color: #1e88e5;
  font-weight: 800;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.field {
  width: 100%;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e5eff9;
  border-radius: 14rpx;
  color: #1f2933;
  background: #f8fbff;
  font-size: 25rpx;
}

.field.full {
  grid-column: span 2;
}

.save-btn {
  margin-top: 20rpx;
}

.empty {
  padding: 48rpx 0;
  color: #7b8794;
  text-align: center;
}

.member-row {
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #eef2f6;
}

.member-row:last-child {
  border-bottom: none;
}

.member-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 0 0 96rpx;
}

.small-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 48rpx;
  border-radius: 24rpx;
  color: #1e88e5;
  background: #eff7ff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.small-btn.danger {
  color: #d64545;
  background: #fff0f0;
}
